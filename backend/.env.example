[TEMPLATE]
# PostgreSQL (default). SQLite still works with sqlite:///bids.db.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bids
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_ORIGINS=http://localhost:3000

# Must match BIDS_INTERNAL_SECRET in frontend/.env.local.
BIDS_INTERNAL_SECRET=replace-with-a-long-random-string

# --- Postgres connection (optional; defaults shown) ---
# DB_SSLMODE=prefer          # "require" for Supabase/Neon/RDS
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800       # seconds; keep it below the pooler's idle timeout
# DB_POOL_TIMEOUT=30

# --- Computed-state cache (optional; defaults shown) ---
# BIDS_CACHE_TTL=900         # seconds before a cached payload is rebuilt
# BIDS_CACHE_FRAMES=4
# BIDS_CACHE_PAYLOADS=64
